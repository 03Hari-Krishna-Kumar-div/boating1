# ─── Production Environment (Render + Neon PostgreSQL) ──────────────────────
# This file is a template. Actual values are set via Render dashboard.
# Copy this file and update the values, or set them in Render's env vars.

APP_NAME="Dhanalakshmi Boating"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://boat-rental-xxxx.onrender.com

# ─── Database: Neon PostgreSQL ──────────────────────────────────────────────
# Get your connection string from Neon dashboard:
#   Settings → Connection Details → Connection string (PSQL)
# Example: postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/brms?sslmode=require
DB_CONNECTION=pgsql
DB_URL=

# ─── Sanctum (web + mobile API auth) ────────────────────────────────────────
SANCTUM_STATEFUL_DOMAINS=boat-rental-xxxx.onrender.com

# ─── Session / Cache / Queue ────────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_DOMAIN=.onrender.com
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database

# ─── Logging ────────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_LEVEL=warning

# ─── Mail ────────────────────────────────────────────────────────────────────
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@brms.local"
MAIL_FROM_NAME="${APP_NAME}"

# ─── App Config ─────────────────────────────────────────────────────────────
BRMS_RENTAL_DURATION=45
BRMS_WARNING_MINUTES=5
BRMS_ALARM_INTERVAL=1
BRMS_SESSION_TIMEOUT=120
BRMS_ONLINE_THRESHOLD=10
BRMS_PAGINATION=50

# ─── Vite ───────────────────────────────────────────────────────────────────
VITE_APP_NAME="${APP_NAME}"
