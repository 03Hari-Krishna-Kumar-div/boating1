{
  "info": {
    "name": "Boat Rental Mobile API",
    "description": "Complete API for the Dhanalakshmi Boating mobile app. All authenticated endpoints require a Bearer token obtained via POST /api/mobile/auth/login.\n\nBase URL: {{base_url}}/api/mobile\n\n## Auth Flow\n1. Call `POST auth/login` with email + password\n2. Copy the `token` value from the response\n3. Set `token` environment variable in Postman\n4. All other endpoints auto-send `Authorization: Bearer {{token}}`\n\n## Local Dev\nbase_url = `http://localhost:8002`\n\n## Production (Render)\nbase_url = `https://your-app.onrender.com`",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8002",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "rental_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "boat_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "notification_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "worker_id",
      "value": "",
      "type": "string"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.environment.set('token', jsonData.token);",
                  "    console.log('Token set: ' + jsonData.token);",
                  "} else {",
                  "    console.log('Login failed: ' + JSON.stringify(jsonData));",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@brms.local\",\n  \"password\": \"password\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/api/mobile/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "mobile", "auth", "login"]
            }
          }
        },
        {
          "name": "Get Current User",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/mobile/auth/user",
              "host": ["{{base_url}}"],
              "path": ["api", "mobile", "auth", "user"]
            }
          }
        }
      ]
    },
