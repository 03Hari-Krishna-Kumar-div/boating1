# ─── Production Environment (Render + Neon PostgreSQL) ──────────────────────
# Copy this file and update the values. Optionally set via Render dashboard.

APP_NAME="Dhanalakshmi Boating"
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://your-app.onrender.com

# ─── Database: Neon PostgreSQL ──────────────────────────────────────────────
# Get your connection string from Neon dashboard:
#   Settings → Connection Details → Connection string (PSL)
# Example: postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/db?sslmode=require
DB_CONNECTION=pgsql
DB_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/dbname?sslmode=require

# ─── Sanctum (mobile token auth — no stateful domains needed) ───────────────
SANCTUM_STATEFUL_DOMAINS=

# ─── Session / Cache / Queue ────────────────────────────────────────────────
SESSION_DRIVER=cookie
SESSION_LIFETIME=120
CACHE_DRIVER=file
QUEUE_CONNECTION=sync

# ─── Logging ────────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_LEVEL=warning

# ─── Mail ────────────────────────────────────────────────────────────────────
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@brms.local"
MAIL_FROM_NAME="${APP_NAME}"

# ─── App Config ─────────────────────────────────────────────────────────────
BRMS_RENTAL_DURATION=45
BRMS_WARNING_MINUTES=5
BRMS_SESSION_TIMEOUT=120
BRMS_ONLINE_THRESHOLD=10

# ─── Vite (not used in production API) ──────────────────────────────────────
VITE_APP_NAME="${APP_NAME}"
